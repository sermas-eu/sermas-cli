{
  "name": "@sermas/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/sermas-eu/sermas-cli.git"
  },
  "version": "1.0.0-alpha.137",
  "type": "module",
  "description": "Sermas CLI",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "BASE_URL=http://localhost:8080 LOG_LEVEL=debug NODE_TLS_REJECT_UNAUTHORIZED=0 tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "clean": "rm -rf ./dist",
    "build": "npm run clean && tsup && cp -r src/tpl dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "bin": {
    "sermas-cli": "./dist/index.js"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "cli-color": "^2.0.4",
    "commander": "^14.0.3",
    "d3-array": "^3.2.5",
    "glob": "^14.0.4",
    "inquirer": "^14.2.5",
    "js-yaml": "^4.3.2",
    "jwt-decode": "^4.0.0",
    "mime-types": "^3.0.2",
    "mqtt": "^5.16.1",
    "ulid": "^3.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cli-color": "^2.0.6",
    "@types/d3-array": "^3.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.1"
  },
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  }
}
